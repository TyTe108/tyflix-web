# Secrets below are required at runtime (once Phase 1+ wires them into config).
# Copy to .env and fill in real values. Never commit .env.

PORT=4000
NODE_ENV=development

SESSION_SECRET=change-me-to-a-long-random-string
PLEX_CLIENT_ID=change-me-plex-client-id
PLEX_BASEURL=http://plex:32400
PLEX_TOKEN=change-me-plex-token
SEERR_URL=http://seerr:5055
SEERR_API_KEY=change-me-seerr-api-key
# Sonarr (TV). Required at boot; nothing constructs the client yet.
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=change-me-sonarr-api-key
DASHBOARD_URL=http://dashboard-host:8787
TMDB_API_KEY=change-me-tmdb-api-key

# Required. Absolute path to the session-revocation JSON file. Must live on a
# persistent volume (e.g. the same /data mount as access-requests) — a path in
# the container's ephemeral layer is wiped on every deploy and silently
# un-revokes every logged-out session.
SESSION_REVOCATION_FILE=/data/session-revocation.json

# Optional. Absolute path to the user-preferences JSON file. Defaults to
# user-preferences.json next to SESSION_REVOCATION_FILE; only set this if the
# two must live apart.
# USER_PREFERENCES_FILE=/data/user-preferences.json

# Optional. Absolute path to the access-requests JSON queue. Unset = feature off.
# Requires a Docker volume mount for the parent directory — do not mkdir -p it.
# ACCESS_REQUESTS_FILE=/data/access-requests.json

# Optional. Transmission RPC base URL, no trailing slash, no credentials.
# Unset = feature off; nothing constructs the client yet.
# A Docker service name will NOT work here: Transmission runs with
# network_mode: service:gluetun in a separate compose project, so it is not on
# tyflix-web's network. Use the host LAN address, like PLEX_BASEURL does.
# TRANSMISSION_URL=http://<SERVER_LAN_IP>:9091
